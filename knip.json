{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": ["*.{js,ts}"]
    },
    "packages/protocol": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/daemon": {
      "entry": [],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/conformance": {
      "entry": ["test/**/*.test.ts", "targets/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "targets/**/*.ts"]
    }
  },
  "ignoreDependencies": []
}
