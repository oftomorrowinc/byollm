{
  "name": "@byollm/conformance",
  "version": "0.1.0-alpha.38",
  "description": "The BYOLLM compatibility contract \u2014 drive a real daemon against any server and assert every protocol MUST.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "byollm-certify": "./dist/cli.js",
    "byollm-audit-deployment": "./dist/audit-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "targets",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuild",
    "certify:reference": "vitest run --project conformance --root ../..",
    "certify:supabase": "node --experimental-strip-types targets/supabase.ts",
    "audit:deployed": "node dist/audit-cli.js"
  },
  "dependencies": {
    "@byollm/protocol": "workspace:*",
    "byollm": "workspace:*"
  },
  "devDependencies": {
    "@byollm/server": "workspace:*",
    "@supabase/supabase-js": "^2.112.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftomorrowinc/byollm.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/oftomorrowinc/byollm/issues"
  }
}
