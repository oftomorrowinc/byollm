{
  "name": "byollm",
  "version": "0.1.0-alpha.38",
  "description": "Bring Your Own LLM — run an app's LLM jobs on your own models. ALPHA: under active development, not for production use.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "byollm": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuild",
    "smoke": "node scripts/smoke.mjs",
    "env-report": "node scripts/env-report.mjs"
  },
  "dependencies": {
    "@byollm/protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://byo-llm.com",
  "keywords": [
    "llm",
    "ollama",
    "mlx",
    "local-llm",
    "byollm",
    "daemon",
    "runner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftomorrowinc/byollm.git",
    "directory": "packages/daemon"
  },
  "bugs": {
    "url": "https://github.com/oftomorrowinc/byollm/issues"
  }
}
