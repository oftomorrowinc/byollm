{
  "name": "@byollm/daemon",
  "version": "0.0.0",
  "description": "The BYOLLM daemon \u2014 run your app's LLM jobs on your own models. npx byollm connect <app>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftomorrowinc/byollm.git",
    "directory": "packages/daemon"
  },
  "bin": {
    "byollm": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuild"
  },
  "dependencies": {
    "@byollm/protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@byollm/server": "workspace:*"
  }
}
