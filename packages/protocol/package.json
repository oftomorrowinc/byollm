{
  "name": "@byollm/protocol",
  "version": "0.0.0",
  "description": "The BYOLLM wire contract — types, zod schemas, and the audience matching rules that both the daemon and server enforce.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftomorrowinc/byollm.git",
    "directory": "packages/protocol"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
