{
  "name": "@byollm/server",
  "version": "0.1.0-alpha.0",
  "description": "Framework-agnostic BYOLLM protocol handlers, a reference in-memory store, a Next.js mount, and a Supabase adapter.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "supabase/migrations",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuild"
  },
  "dependencies": {
    "@byollm/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "//": "private: held back from the alpha. Remove this line (and `private`) to publish; the package is otherwise ready."
}
